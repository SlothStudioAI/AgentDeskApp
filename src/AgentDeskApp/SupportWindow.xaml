<Window x:Class="AgentDeskApp.SupportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="620" Width="560" MinHeight="400" MinWidth="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MainBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Yu Gothic UI, Segoe UI, Meiryo"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/PopupStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel Margin="20">
        <!-- 下部: 閉じるボタン(主ボタン=緑) -->
        <Button x:Name="CloseButton" DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,14,0,0"
                Padding="18,7" Style="{StaticResource ForestPrimaryButtonStyle}" IsDefault="True" Click="CloseButton_Click"/>

        <!-- 上部: 見出し -->
        <TextBlock x:Name="HeaderTextBlock" DockPanel.Dock="Top" FontSize="18" FontWeight="Bold"
                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>

        <!-- 本文(スクロール可)。セクションはコードで組み立てる -->
        <Border Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1" CornerRadius="{StaticResource CornerRadiusLarge}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16">
                <StackPanel x:Name="SectionsPanel"/>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
