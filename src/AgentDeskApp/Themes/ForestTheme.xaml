<!-- 森テーマの共有リソース(アプリ全体で共有)。配色ブラシ・角丸・スクロールバー・ツールチップ・メニューを定義する。
     App.xaml の MergedDictionaries で読み込むため、メイン画面・サポート・各ポップアップから同じキーで参照できる。
     色・角丸の変更は、このファイルだけで行う。 -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
        <!-- ===== 角丸の大きさ(柔らかい森の印象。丸みの調整はここだけで行う) =====
             ウィンドウ自体の外形の角丸はWindows 11のDWMが描く(MainWindow.xaml.csのWindowCornerPreference定数)。
             メンバー/リーダーカードの角丸はコードビハインド側の定数(CardCornerRadius / LeaderCardCornerRadius)で指定する。 -->
        <!-- 小: ＋ボタン、キャプションボタンのホバー面、メニュー項目 -->
        <CornerRadius x:Key="CornerRadiusSmall">8</CornerRadius>
        <!-- 中: ヘッダーボタン、警告枠、ツールチップ、メニュー、トースト、サイドバー項目 -->
        <CornerRadius x:Key="CornerRadiusMedium">14</CornerRadius>
        <!-- 大: TEAM/WORKSPACEパネル、空状態、ウェルカムパネル -->
        <CornerRadius x:Key="CornerRadiusLarge">20</CornerRadius>
        <!-- ピル: 両端が完全な半円になる(バッジ、検索ボックス、切替ピル、スクロールバーのつまみ) -->
        <CornerRadius x:Key="CornerRadiusPill">999</CornerRadius>

        <!-- ===== 配色リソース(森イメージ: 明るい緑サイドバー+薄い黄色背景+薄クリームのパネル)。色の変更はここだけで行う ===== -->
        <!-- 左サイドバーの背景(明るめの森の緑) -->
        <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#2F6B45"/>
        <!-- サイドバーの区切り線・枠線 -->
        <SolidColorBrush x:Key="SidebarBorderBrush" Color="#4C8A63"/>
        <!-- サイドバー項目のホバー背景 -->
        <SolidColorBrush x:Key="SidebarHoverBrush" Color="#35704A"/>
        <!-- サイドバー項目の選択中背景 -->
        <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#3B7D52"/>
        <!-- サイドバーの通常文字(淡いクリームグリーン。背景に対し約5.9:1) -->
        <SolidColorBrush x:Key="SidebarTextBrush" Color="#F2F8EE"/>
        <!-- サイドバーの見出し・補助文字 -->
        <SolidColorBrush x:Key="SidebarMutedTextBrush" Color="#CFE3CF"/>
        <!-- サイドバーのアクセント(アイコン等) -->
        <SolidColorBrush x:Key="SidebarAccentBrush" Color="#D9F28A"/>
        <!-- サイドバーのロゴ丸の背景 -->
        <SolidColorBrush x:Key="SidebarLogoBrush" Color="#6DB67F"/>
        <!-- メイン画面の背景(薄い黄色。カード領域の地色) -->
        <SolidColorBrush x:Key="MainBackgroundBrush" Color="#FBF6DC"/>
        <!-- ヘッダー・TEAM/WORKSPACEパネル・空状態など、黄色背景の上に乗る薄いクリーム色の面 -->
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFFCEF"/>
        <!-- パネルの枠線(淡いグレー) -->
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#E2E8F0"/>

        <!-- ===== タイトルバー(サイドバーの緑とつながる緑系)。色・高さの変更はここだけで行う ===== -->
        <!-- タイトルバーの高さ(WindowChrome.CaptionHeightと同じ値にすること) -->
        <GridLength x:Key="TitleBarHeight">38</GridLength>
        <!-- タイトルバー背景: サイドバーと同じ単色(SidebarBackgroundBrushを直接参照する。専用ブラシは持たない) -->
        <!-- タイトルバー下端の区切り線(サイドバーの区切り線SidebarBorderBrushと同じ色) -->
        <SolidColorBrush x:Key="TitleBarBorderBrush" Color="#4C8A63"/>
        <!-- タイトル文字(淡いクリーム白) -->
        <SolidColorBrush x:Key="TitleBarTextBrush" Color="#F7FBF1"/>
        <!-- キャプションボタンの通常アイコン色 -->
        <SolidColorBrush x:Key="TitleBarButtonForegroundBrush" Color="#F2F8EE"/>
        <!-- キャプションボタンのホバー背景(明るい緑) -->
        <SolidColorBrush x:Key="TitleBarButtonHoverBrush" Color="#3B7D52"/>
        <!-- キャプションボタンの押下背景 -->
        <SolidColorBrush x:Key="TitleBarButtonPressedBrush" Color="#1F4D32"/>
        <!-- 閉じるボタンのホバー/押下背景(赤系) -->
        <SolidColorBrush x:Key="TitleBarCloseHoverBrush" Color="#C94242"/>
        <SolidColorBrush x:Key="TitleBarClosePressedBrush" Color="#A83333"/>

        <!-- ===== ポップアップ(設定・ルール・メンバー編集など)向けの追加リソース ===== -->
        <!-- タブ見出しの角丸(上側だけ丸い) -->
        <CornerRadius x:Key="CornerRadiusTab">12,12,0,0</CornerRadius>
        <!-- 本文の標準文字色(濃い茶。サポート画面の本文と同じ) -->
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#3B2A1E"/>
        <!-- 補助説明の文字色(落ち着いた緑グレー。クリーム背景に対し約4.6:1) -->
        <SolidColorBrush x:Key="TextMutedBrush" Color="#6B7762"/>
        <!-- 見出し・強調・リンクの緑 -->
        <SolidColorBrush x:Key="AccentGreenBrush" Color="#2F6B45"/>
        <!-- 主ボタン(緑)のホバー/押下 -->
        <SolidColorBrush x:Key="AccentGreenHoverBrush" Color="#265A39"/>
        <SolidColorBrush x:Key="AccentGreenPressedBrush" Color="#1F4D32"/>
        <!-- 入力欄の背景・枠線・フォーカス枠 -->
        <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="InputBorderBrush" Color="#D5DCC8"/>
        <SolidColorBrush x:Key="InputFocusBorderBrush" Color="#2F6B45"/>
        <!-- 副ボタン(キャンセル等)の背景。クリーム+枠線 -->
        <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="#FFFCEF"/>
        <!-- パネルの中のくぼみ(読み取り専用欄・情報帯)の背景。パネルより少し濃いクリーム -->
        <SolidColorBrush x:Key="PanelInsetBrush" Color="#F4F1DA"/>
        <!-- ルール編集欄(コード風エディタ)の背景と文字。深い森の緑 -->
        <SolidColorBrush x:Key="EditorBackgroundBrush" Color="#23382B"/>
        <SolidColorBrush x:Key="EditorForegroundBrush" Color="#F2F8EE"/>
        <!-- 警告の文字色(取消・エラー系)と成功の文字色 -->
        <SolidColorBrush x:Key="WarningTextBrush" Color="#B45309"/>
        <SolidColorBrush x:Key="DangerTextBrush" Color="#C94242"/>

        <!-- ===== ポップアップの角丸スタイル ===== -->
        <!-- 淡い緑グレー(ボタン押下時の背景に使う。スクロールバーは標準の見た目に戻したためここでは定義しない) -->
        <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#B8C7B0"/>
        <!-- ツールチップ・メニューの枠線色 -->
        <SolidColorBrush x:Key="PopupBorderBrush" Color="#D5DCC8"/>
        <!-- メニュー項目のホバー背景(淡い緑) -->
        <SolidColorBrush x:Key="MenuItemHighlightBrush" Color="#E6EFD8"/>

        <!-- ツールチップ(サイドバーのパス表示・メンバー追従ポップアップ共通)。角丸の淡いクリーム色の面 -->
        <Style x:Key="RoundedToolTipStyle" TargetType="ToolTip">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PopupBorderBrush}"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource CornerRadiusMedium}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ToolTip" BasedOn="{StaticResource RoundedToolTipStyle}"/>

        <!-- 右クリックメニュー/通知メニュー(コードビハインドのApplyRoundedMenuStyleで各項目にも適用する) -->
        <Style x:Key="RoundedContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PopupBorderBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource CornerRadiusMedium}" Padding="4">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- メニュー項目(ホバーで淡い緑の角丸ハイライト) -->
        <Style x:Key="RoundedMenuItemStyle" TargetType="MenuItem">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="itemBorder" Background="Transparent" CornerRadius="{StaticResource CornerRadiusSmall}" Padding="12,6" MinWidth="160">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="{StaticResource MenuItemHighlightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="itemBorder" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- メニューの区切り線 -->
        <Style x:Key="RoundedMenuSeparatorStyle" TargetType="Separator">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Margin="8,4" Background="{StaticResource PopupBorderBrush}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
</ResourceDictionary>
