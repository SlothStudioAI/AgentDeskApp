<Window x:Class="AgentDeskApp.AgentDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AgentDeskApp"
        Title="メンバー詳細" Height="560" Width="440" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MainBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Yu Gothic UI, Segoe UI, Meiryo">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/PopupStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel Margin="16">
        <TextBlock x:Name="DetailName" DockPanel.Dock="Top" FontSize="20" FontWeight="Bold"/>
        <TextBlock x:Name="DetailScope" DockPanel.Dock="Top" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,8"/>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="EditButton" Content="編集" Padding="16,5" Margin="0,0,8,0" Style="{StaticResource ForestPrimaryButtonStyle}" Click="EditButton_Click"/>
            <Button x:Name="DeleteButton" Content="削除" Padding="16,5" Click="DeleteButton_Click"/>
        </StackPanel>

        <Border Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource CornerRadiusLarge}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,14">
            <StackPanel>
                <TextBlock Text="説明(委譲判断に使う文):" FontWeight="Bold" Margin="0,4,0,2"/>
                <TextBlock x:Name="DetailDescription" TextWrapping="Wrap"/>
                <TextBlock Text="使用ツール / モデル:" FontWeight="Bold" Margin="0,8,0,2"/>
                <TextBlock x:Name="DetailToolsModel" TextWrapping="Wrap"/>

                <TextBlock Text="個性・行動ルール:" FontWeight="Bold" Margin="0,12,0,4"/>
                <ItemsControl x:Name="DetailSections">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:BodySection}">
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="{StaticResource AccentGreenBrush}"/>
                                <Rectangle Height="1" Fill="{StaticResource InputBorderBrush}" Margin="0,2,0,4"/>
                                <TextBlock Text="{Binding Content}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
