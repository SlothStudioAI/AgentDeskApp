<Window x:Class="AgentDeskApp.AgentEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="メンバー編集" Height="860" Width="700" MinHeight="820" MinWidth="660" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MainBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Yu Gothic UI, Segoe UI, Meiryo">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/PopupStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="120"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TargetText" Grid.Row="0" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>

        <!-- 配備先（エンジン）選択ウィザード -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="配備先:" VerticalAlignment="Center" Width="80" FontWeight="SemiBold"/>
            <Border Background="{StaticResource PanelInsetBrush}" CornerRadius="{StaticResource CornerRadiusMedium}" Padding="8,4">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="DeploySharedRadio" GroupName="DeployEngine" Content="🔄 両方に配備 (Shared)" IsChecked="True" Margin="0,0,14,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <RadioButton x:Name="DeployClaudeRadio" GroupName="DeployEngine" Content="🦥 Claude 専用" Margin="0,0,14,0" VerticalAlignment="Center"/>
                    <RadioButton x:Name="DeployGeminiRadio" GroupName="DeployEngine" Content="🌟 Gemini 専用" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- アバター画像設定 (D&D / ファイル選択 / プレビュー) -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="58"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="アバター:" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <!-- プレビュー枠 -->
            <Border x:Name="AvatarPreviewBorder" Grid.Column="1" Width="48" Height="48" CornerRadius="24" Background="{StaticResource PanelInsetBrush}" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1.5" HorizontalAlignment="Left" VerticalAlignment="Center" ClipToBounds="True">
                <TextBlock x:Name="AvatarInitialText" Text="?" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <!-- ドロップエリア & ボタン -->
            <Border Grid.Column="2" x:Name="AvatarDropZone" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1.5" CornerRadius="{StaticResource CornerRadiusMedium}" Padding="10,6" Margin="6,0,0,0" AllowDrop="True" Drop="AvatarDropZone_Drop" DragOver="AvatarDropZone_DragOver" DragLeave="AvatarDropZone_DragLeave">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="AvatarStatusText" Text="🖼️ 画像をここにドラッグ＆ドロップ" FontSize="11.5" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="PNG, JPG, WebP (自動で正方形・円形にトリミング表示)" FontSize="10" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>
                    <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" MaxWidth="280" Margin="10,0,0,0">
                        <Button x:Name="SelectAvatarButton" Content="📁 選択" Padding="8,3" FontSize="11" Margin="0,0,6,0" Click="SelectAvatarButton_Click"/>
                        <!-- 同梱画像があるメンバーだけ表示する(コードビハインドで切り替え) -->
                        <Button x:Name="RestoreBundledAvatarButton" Content="標準の画像に戻す" Padding="8,3" FontSize="11" Margin="0,0,6,0" Visibility="Collapsed" ToolTip="アプリ同梱の標準アバター画像に戻す" Click="RestoreBundledAvatarButton_Click"/>
                        <Button x:Name="ClearAvatarButton" Content="✕" Padding="6,3" FontSize="11" ToolTip="アバター画像を解除" Click="ClearAvatarButton_Click"/>
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="名前(識別子):" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <TextBox x:Name="NameTextBox" Grid.Column="1"
                     ToolTip="CLIやAPIから呼び出す半角英数字の識別子。作成後は変更できません"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="※半角英数字・ハイフンのみ（例: helper, web-researcher）。日本語は下の「表示名」へ" FontSize="10.5" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
        </Grid>

        <Grid Grid.Row="4" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="表示名:" VerticalAlignment="Center"/>
            <TextBox x:Name="DisplayNameTextBox" Grid.Column="1"
                     ToolTip="画面表示だけに使う名前(省略時は「名前(識別子)」をそのまま表示)。いつでも変更できます"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="※カードや画面上に表示する日本語の名前（例: なまけものリサーチャー）" FontSize="10.5" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
        </Grid>

        <Grid Grid.Row="5" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="説明(役割):" VerticalAlignment="Top" FontWeight="SemiBold" Margin="0,4,0,0"/>
            <TextBox x:Name="DescriptionTextBox" Grid.Column="1" Height="66" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                     ToolTip="AIリーダーが『この仕事は誰に任せるべきか』を判断する最も重要なプロンプトです"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="※AIがタスクを自動委譲する際の判断基準になります（例: Web検索やドキュメント調査を担当する専門家）" FontSize="10.5" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
        </Grid>

        <!-- ツール: ラベルは左列、チェックボックス群は入力欄と左端をそろえて右列に置く(各項目は固定幅で列がそろう) -->
        <Grid Grid.Row="6" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="ツール:" VerticalAlignment="Top" Margin="0,2,0,0" ToolTip="該当するものにチェックしてください"/>
            <StackPanel Grid.Column="1">
                <TextBlock Text="該当するものにチェック" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                <WrapPanel x:Name="ToolsCheckPanel" HorizontalAlignment="Left"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="7" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="その他のツール:" VerticalAlignment="Center"/>
            <TextBox x:Name="ExtraToolsTextBox" Grid.Column="1"
                     ToolTip="一覧に無いツール(MCPツール名等)をカンマ区切りで追加できます"/>
        </Grid>

        <Grid x:Name="ClaudeModelPanel" Grid.Row="8" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                       ToolTip="色は Claude Code での表示色です。空でも問題ありません"><Run Text="モデル(Claude) /"/><LineBreak/><Run Text="色(Claude Code):" FontSize="10.5"/></TextBlock>
            <ComboBox x:Name="ModelComboBox" Grid.Column="1" IsEditable="True"/>
            <ComboBox x:Name="ColorComboBox" Grid.Column="3" IsEditable="True"
                      ToolTip="Claude Code での表示色です。空でも問題ありません"/>
        </Grid>

        <Grid x:Name="GeminiModelPanel" Grid.Row="9" Margin="0,0,0,8" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="モデル(Gemini):" VerticalAlignment="Center"/>
            <ComboBox x:Name="GeminiModelComboBox" Grid.Column="1" IsEditable="True"/>
        </Grid>

        <!-- 個性・行動ルール: 残りの高さを使い、最低でも3行分が見えるよう MinHeight を確保する -->
        <DockPanel Grid.Row="10" Margin="0,0,0,8">
            <TextBlock Text="個性・行動ルール(## 見出しでセクション分けされます):" DockPanel.Dock="Top" Margin="0,0,0,4"/>
            <TextBox x:Name="BodyTextBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="80"/>
        </DockPanel>

        <StackPanel Grid.Row="11" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="キャンセル" Padding="14,4" Margin="0,0,8,0" Click="CancelButton_Click"/>
            <Button x:Name="SaveButton" Content="保存" Padding="18,4" Style="{StaticResource ForestPrimaryButtonStyle}" Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
