<Window x:Class="AgentDeskApp.RulePopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="チームルール管理 (Team Rules)" Height="680" Width="820"
        WindowStartupLocation="CenterOwner"
        KeyDown="Window_KeyDown"
        Background="{DynamicResource MainBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Yu Gothic UI, Segoe UI, Meiryo">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/PopupStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel Margin="24">
        <!-- 1. 最下部アクションバー -->
        <Border DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <TextBlock x:Name="SaveNoticeText" Text="✅ 保存しました！" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentGreenBrush}" VerticalAlignment="Center" Visibility="Collapsed"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="OpenFolderButton" Content="📂 フォルダを開く" Padding="14,7" Margin="0,0,10,0"
                            FontWeight="SemiBold" Click="OpenFolderButton_Click"/>
                    <Button x:Name="SaveButton" Content="💾 ルールを保存 (Ctrl+S)" Padding="18,7" Margin="0,0,10,0"
                            Style="{StaticResource ForestPrimaryButtonStyle}" Click="SaveButton_Click"/>
                    <Button Content="閉じる" Padding="16,7" FontWeight="SemiBold" Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. 上部ヘッダー -->
        <Border DockPanel.Dock="Top" Margin="0,0,0,16">
            <Grid>
                <StackPanel>
                    <TextBlock x:Name="HeaderText" Text="チームのルール管理" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Claude Code (CLAUDE.md) および Gemini / Antigravity (GEMINI.md) の共通行動指針を直接編集・保存できます。"
                               FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <!-- 親スコープのルールへの導線 (U-4): チーム/グループ選択時のみ表示 -->
                <Button x:Name="ParentRuleButton" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Padding="12,6" FontSize="11.5" FontWeight="SemiBold"
                        Visibility="Collapsed" Click="ParentRuleButton_Click"/>
            </Grid>
        </Border>

        <!-- 3. ルールエディタタブ -->
        <TabControl x:Name="RuleTabControl">
            <!-- CLAUDE.md タブ -->
            <TabItem Header="🦥 CLAUDE.md (Claude Code)">
                <DockPanel Margin="12">
                    <Border DockPanel.Dock="Top" Background="{StaticResource PanelInsetBrush}" CornerRadius="{StaticResource CornerRadiusSmall}" Padding="10,6" Margin="0,0,0,10">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📁 配置パス: " FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock x:Name="ClaudeFilePathText" Text="-" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Consolas"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="CopyClaudeButton" Content="📋 コピー" Padding="8,4" FontSize="11" FontWeight="SemiBold" Margin="0,0,5,0"
                                        ToolTip="ルール全文をクリップボードにコピー" Click="CopyClaudeButton_Click"/>
                                <Button x:Name="ImportToClaudeButton" Content="🔄 GEMINI.mdから移植..." Padding="8,4" FontSize="11" FontWeight="SemiBold" Margin="0,0,5,0"
                                        Click="ImportToClaudeButton_Click"/>
                                <Button x:Name="ImportFileToClaudeButton" Content="📂 外部読込..." Padding="8,4" FontSize="11" FontWeight="SemiBold" Margin="0,0,5,0"
                                        ToolTip="別グループ等のファイルから取り込む" Click="ImportFileToClaudeButton_Click"/>
                                <Button x:Name="BackupClaudeButton" Content="📦 バックアップ" Padding="8,4" FontSize="11" FontWeight="SemiBold"
                                        Click="BackupClaudeButton_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Background="{StaticResource EditorBackgroundBrush}" CornerRadius="{StaticResource CornerRadiusMedium}" Padding="10">
                        <TextBox x:Name="ClaudeContentTextBox" TextWrapping="Wrap" AcceptsReturn="True" AcceptsTab="True"
                                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="13"
                                 Background="Transparent" Foreground="{StaticResource EditorForegroundBrush}" BorderThickness="0" CaretBrush="{StaticResource EditorForegroundBrush}"/>
                    </Border>
                </DockPanel>
            </TabItem>

            <!-- GEMINI.md タブ -->
            <TabItem Header="🌟 GEMINI.md (Antigravity)">
                <DockPanel Margin="12">
                    <Border DockPanel.Dock="Top" Background="{StaticResource PanelInsetBrush}" CornerRadius="{StaticResource CornerRadiusSmall}" Padding="10,6" Margin="0,0,0,10">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📁 配置パス: " FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock x:Name="GeminiFilePathText" Text="-" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Consolas"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="CopyGeminiButton" Content="📋 コピー" Padding="8,4" FontSize="11" FontWeight="SemiBold" Margin="0,0,5,0"
                                        ToolTip="ルール全文をクリップボードにコピー" Click="CopyGeminiButton_Click"/>
                                <Button x:Name="ImportToGeminiButton" Content="🔄 CLAUDE.mdから移植..." Padding="8,4" FontSize="11" FontWeight="SemiBold" Margin="0,0,5,0"
                                        Click="ImportToGeminiButton_Click"/>
                                <Button x:Name="ImportFileToGeminiButton" Content="📂 外部読込..." Padding="8,4" FontSize="11" FontWeight="SemiBold" Margin="0,0,5,0"
                                        ToolTip="別グループ等のファイルから取り込む" Click="ImportFileToGeminiButton_Click"/>
                                <Button x:Name="BackupGeminiButton" Content="📦 バックアップ" Padding="8,4" FontSize="11" FontWeight="SemiBold"
                                        Click="BackupGeminiButton_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Background="{StaticResource EditorBackgroundBrush}" CornerRadius="{StaticResource CornerRadiusMedium}" Padding="10">
                        <TextBox x:Name="GeminiContentTextBox" TextWrapping="Wrap" AcceptsReturn="True" AcceptsTab="True"
                                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="13"
                                 Background="Transparent" Foreground="{StaticResource EditorForegroundBrush}" BorderThickness="0" CaretBrush="{StaticResource EditorForegroundBrush}"/>
                    </Border>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
