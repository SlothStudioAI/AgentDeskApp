<Window x:Class="AgentDeskApp.AgentTemplateImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="📑 職種別テンプレートからメンバー追加 (Role Templates)" Height="720" Width="900" MinHeight="620" MinWidth="780"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MainBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Yu Gothic UI, Segoe UI, Meiryo">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/PopupStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- 小さな補助ボタン(一括モデル設定など) -->
            <Style x:Key="SmallActionButton" TargetType="Button" BasedOn="{StaticResource ForestButtonStyle}">
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>
            <!-- 主ボタン(メンバー追加の実行) -->
            <Style x:Key="PrimaryImportButton" TargetType="Button" BasedOn="{StaticResource ForestPrimaryButtonStyle}">
                <Setter Property="Padding" Value="18,8"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Margin="24">
        <!-- 1. 最下部アクションバー -->
        <Border DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 左: 選択数・保存先・注記。保存先は折り返し、行ごとに固定行高を取って重なりを防ぐ -->
                <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="選択中: " FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="SelectedCountText" Text="0 名" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource AccentGreenBrush}"/>
                        <TextBlock Text=" ｜ 登録先: " FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="10,0,0,0"/>
                        <TextBlock x:Name="TargetScopeText" Text="○○チーム" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>
                    <TextBlock x:Name="TargetFolderPathText" Text="C:\..." FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" FontFamily="Consolas" Margin="0,4,0,0" TextWrapping="Wrap" LineHeight="15" LineStackingStrategy="BlockLineHeight"/>
                    <TextBlock x:Name="SharedStateNoteText" Text="" Visibility="Collapsed" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="DeployNoteText" Text="ℹ️" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap" LineHeight="16" LineStackingStrategy="BlockLineHeight"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="ImportSelectedButton" Content="🚀 選択したメンバーをチームに追加" Style="{StaticResource PrimaryImportButton}" Margin="0,0,10,0" Click="ImportSelectedButton_Click"/>
                    <Button Content="閉じる" Padding="14,8" FontSize="12" FontWeight="SemiBold" Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. 上部ヘッダー（カテゴリ選択・一括モデル変更） -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource CornerRadiusLarge}" Padding="16,14" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📂 職種カテゴリ:" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox x:Name="CategoryComboBox" Width="260" Height="30" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" SelectionChanged="CategoryComboBox_SelectionChanged"/>
                    </StackPanel>

                    <!-- 一括モデル変更ボタン群 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="一括モデル設定:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Button Content="🌟 推奨に戻す" Style="{StaticResource SmallActionButton}" Margin="0,0,5,0" ToolTip="レビュー・設計は最高知能、定型は超軽量・最速、他は高速・低コスト(標準バランス)の推奨段階に戻します" Click="ApplyRecommendedModels_Click"/>
                        <Button Content="⚡ 全員 高速・低コスト" Style="{StaticResource SmallActionButton}" Margin="0,0,5,0" ToolTip="コストと精度のバランス重視ですべて高速・低コスト(Claude: sonnet / Gemini: flash)にします" Click="ApplyAllStandard_Click"/>
                        <Button Content="⚡ 全員 超軽量・最速" Style="{StaticResource SmallActionButton}" ToolTip="費用最小限・最速重視ですべて超軽量・最速(Claude: haiku / Gemini: flash_lite)にします" Click="ApplyAllUltraLight_Click"/>
                    </StackPanel>
                </Grid>

                <!-- 配置先(全員共通): Claude / Gemini / 両方(Shared) -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,10,0,0">
                    <TextBlock Text="🚚 配置先:" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Border Background="{StaticResource PanelInsetBrush}" CornerRadius="{StaticResource CornerRadiusMedium}" Padding="8,4">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="DeployClaudeRadio" GroupName="DeployEngine" Content="🦥 Claude 専用" IsChecked="True" Margin="0,0,14,0" VerticalAlignment="Center" FontWeight="SemiBold" Checked="DeployRadio_Checked"/>
                            <RadioButton x:Name="DeployGeminiRadio" GroupName="DeployEngine" Content="🌟 Gemini 専用" Margin="0,0,14,0" VerticalAlignment="Center" Checked="DeployRadio_Checked"/>
                            <RadioButton x:Name="DeploySharedRadio" GroupName="DeployEngine" Content="🔄 両方に配備 (Shared)" VerticalAlignment="Center" Checked="DeployRadio_Checked"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border Grid.Row="2" Background="{StaticResource PanelBackgroundBrush}" CornerRadius="{StaticResource CornerRadiusSmall}" Padding="10,6" Margin="0,10,0,0">
                    <Grid>
                        <TextBlock x:Name="CategoryDescriptionText" Text="職種の説明" FontSize="11.5" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <CheckBox x:Name="SelectAllCheckBox" Content="すべて選択" IsChecked="True" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Checked="SelectAllCheckBox_Checked" Unchecked="SelectAllCheckBox_Unchecked"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- 3. エージェント一覧（スクロール対応） -->
        <Border Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource CornerRadiusLarge}" Padding="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="TemplatesItemsPanel"/>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
