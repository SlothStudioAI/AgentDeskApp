<Window x:Class="AgentDeskApp.AgentTaskHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="📋 タスク履歴・実行ログ (Task History)" Height="580" Width="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MainBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Yu Gothic UI, Segoe UI, Meiryo">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/PopupStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="HeaderTitleText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Margin="24">
        <!-- 1. 最下部アクションバー -->
        <Border DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="RefreshButton" Content="🔄 更新" Padding="14,6" Margin="0,0,10,0" FontWeight="SemiBold" Click="RefreshButton_Click"/>
                <Button Content="閉じる" Padding="18,6" Style="{StaticResource ForestPrimaryButtonStyle}" Click="CloseButton_Click"/>
            </StackPanel>
        </Border>

        <!-- 2. 上部ヘッダー（エージェント情報） -->
        <Border DockPanel.Dock="Top" Background="{StaticResource SidebarBackgroundBrush}" CornerRadius="{StaticResource CornerRadiusLarge}" Padding="18,14" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- アバター -->
                <Border x:Name="AvatarBorder" Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="{StaticResource SidebarLogoBrush}" Margin="0,0,14,0" BorderBrush="#FFFFFF" BorderThickness="1.5"/>

                <!-- 名前・役割 -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="AgentNameText" Text="Agent Name" FontSize="16" FontWeight="Bold" Foreground="{StaticResource SidebarTextBrush}" Margin="0,0,8,0"/>
                        <Border x:Name="EngineBadgeBorder" Background="{StaticResource SidebarSelectedBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock x:Name="EngineBadgeText" Text="🦥 Claude" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource SidebarTextBrush}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="AgentRoleText" Text="Description or role" FontSize="12" Foreground="{StaticResource SidebarMutedTextBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- 累計実行数 -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock x:Name="TotalCountText" Text="0 件のタスク履歴" FontSize="12" FontWeight="Bold" Foreground="{StaticResource SidebarAccentBrush}" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. タスク履歴リスト & 詳細スプリットビュー -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左側: タスク履歴リスト -->
            <Border Grid.Column="0" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource CornerRadiusMedium}" Padding="6">
                <Grid>
                    <!-- 空メッセージ -->
                    <TextBlock x:Name="EmptyNoticeText" Text="過去のタスク実行ログはまだありません。" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="16" Visibility="Collapsed"/>

                    <ListBox x:Name="TaskListBox" BorderThickness="0" Background="Transparent"
                             SelectionChanged="TaskListBox_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="0,0,0,1" Padding="8,10" Background="Transparent">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,4">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Engine}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource AccentGreenBrush}" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding SessionId, StringFormat='[#{0}]'}" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" FontFamily="Consolas"/>
                                            </StackPanel>
                                            <Border HorizontalAlignment="Right" Background="#DEF7EC" CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold" Foreground="#03543F"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding Instruction}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"
                                                   MaxHeight="36" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Timestamp, StringFormat='yyyy/MM/dd HH:mm:ss'}" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- 右側: 選択したタスクの詳細 -->
            <Border Grid.Column="2" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource CornerRadiusMedium}" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="DetailPanel">
                        <!-- ユーザーの依頼 -->
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="👤 ユーザーの依頼 (User Request)" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <Button x:Name="CopyUserRequestButton" Content="📋 コピー" Padding="8,2" FontSize="11" HorizontalAlignment="Right" Click="CopyUserRequestButton_Click"/>
                        </Grid>
                        <Border Background="{StaticResource PanelInsetBrush}" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource CornerRadiusSmall}" Padding="10" Margin="0,0,0,14">
                            <TextBox x:Name="DetailUserRequestText" TextWrapping="Wrap" IsReadOnly="True" Background="Transparent"
                                     BorderThickness="0" FontSize="12.5" FontWeight="SemiBold" FontFamily="Segoe UI, Yu Gothic UI" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </Border>

                        <!-- リーダーの指示 -->
                        <Grid Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🤖 リーダーの指示 (Leader Instruction)" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock x:Name="InstructionLengthBadge" Text="" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button x:Name="CopyInstructionButton" Content="📋 コピー" Padding="8,2" FontSize="11" HorizontalAlignment="Right" Click="CopyInstructionButton_Click"/>
                        </Grid>
                        <Border Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource CornerRadiusSmall}" Padding="10" Margin="0,0,0,4">
                            <TextBox x:Name="DetailInstructionText" TextWrapping="Wrap" IsReadOnly="True" Background="Transparent"
                                     BorderThickness="0" FontSize="12" FontFamily="Segoe UI, Yu Gothic UI" Foreground="{StaticResource TextPrimaryBrush}" MaxHeight="120"/>
                        </Border>
                        <Button x:Name="ToggleInstructionButton" Content="▼ 全文を展開する" Margin="0,0,0,14" HorizontalAlignment="Left"
                                Padding="8,3" FontSize="11" Style="{StaticResource ForestLinkButtonStyle}" Background="Transparent"
                                Visibility="Collapsed" Click="ToggleInstructionButton_Click"/>

                        <!-- 実行メタデータ -->
                        <TextBlock Text="ℹ️ 実行メタデータ" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                        <Border Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource CornerRadiusSmall}" Padding="10" Margin="0,0,0,14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="実行エンジン:" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,2"/>
                                <TextBlock x:Name="DetailEngineText" Grid.Row="0" Grid.Column="1" Text="-" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="セッションID:" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,2"/>
                                <TextBlock x:Name="DetailSessionIdText" Grid.Row="1" Grid.Column="1" Text="-" FontSize="11.5" FontFamily="Consolas" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="実行日時:" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,2"/>
                                <TextBlock x:Name="DetailTimestampText" Grid.Row="2" Grid.Column="1" Text="-" FontSize="11.5" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2"/>
                            </Grid>
                        </Border>

                        <!-- 実行結果・AI回答 -->
                        <Grid Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="💬 実行結果・AI回答 (Result)" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock x:Name="ResultLengthBadge" Text="" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button x:Name="CopyResultButton" Content="📋 コピー" Padding="8,2" FontSize="11" HorizontalAlignment="Right" Click="CopyResultButton_Click"/>
                        </Grid>
                        <Border Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource CornerRadiusSmall}" Padding="10" Margin="0,0,0,4">
                            <TextBox x:Name="DetailResultText" Text="-" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"
                                     IsReadOnly="True" Background="Transparent" BorderThickness="0" FontFamily="Segoe UI, Yu Gothic UI" MaxHeight="180"/>
                        </Border>
                        <Button x:Name="ToggleResultButton" Content="▼ 全文を展開する" Margin="0,0,0,10" HorizontalAlignment="Left"
                                Padding="8,3" FontSize="11" Style="{StaticResource ForestLinkButtonStyle}" Background="Transparent"
                                Visibility="Collapsed" Click="ToggleResultButton_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
